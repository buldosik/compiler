# Rozkład na czynniki pierwsze
PROCEDURE check(n,d,p) IS
  r
BEGIN
    p:=0;
    r:=n%d;
    WRITE 333333333;
    WRITE n;
    WRITE d;
    WRITE r;
    WHILE p<10 DO
        WRITE 444444444;
        WRITE n;
        n:=n/d;
        WRITE n;
        p:=p+1;
        WRITE p;
        r:=n%d;
        WRITE r;
    ENDWHILE
    WRITE p;
END

PROGRAM IS
  n,m,potega,dzielnik
BEGIN
  READ n;
  WRITE n;
  dzielnik:=2;
  m:=dzielnik*dzielnik;
  WRITE m;
  WRITE 1111111111;
  WHILE n>=m DO
    check(n,dzielnik,potega);
    IF potega>0 THEN # jest podzielna przez dzielnik
      WRITE dzielnik;
      WRITE potega;
    ENDIF
    dzielnik:=dzielnik+1;
    m:=dzielnik*dzielnik;
  ENDWHILE
  IF n!=1 THEN # ostatni dzielnik różny od 1
    WRITE n;
    WRITE 1;
  ENDIF
END
